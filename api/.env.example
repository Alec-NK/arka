# PostgreSQL container (also used to build DATABASE_URL inside docker compose)
POSTGRES_USER=arka
POSTGRES_PASSWORD=arka
POSTGRES_DB=arka
POSTGRES_PORT=5432
APP_DATABASE_USER=arka_app
APP_DATABASE_PASSWORD=arka_app

# API
API_PORT=3000
PORT=3000

# Runtime connection uses the restricted application role. Migrations use the admin URL below.
DATABASE_URL="postgresql://arka_app:arka_app@localhost:5432/arka?schema=public"
MIGRATION_DATABASE_URL="postgresql://arka:arka@localhost:5432/arka?schema=public"
